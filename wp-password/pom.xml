<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.quarkword.keycloak</groupId>
    <artifactId>quarkword-keycloak-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkword-keycloak-wp-password</artifactId>
  <name>QuarkWord Keycloak WordPress Password Hashes</name>
  <description>A Keycloak password hash provider that verifies imported WordPress password hashes</description>

  <properties>
    <automatic.module.name>org.quarkword.keycloak.wppassword</automatic.module.name>
  </properties>

  <dependencies>
    <!-- Keycloak's classes come from the server: provided, never shaded -->
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
    </dependency>
    <!-- shaded into the jar and relocated -->
    <dependency>
      <groupId>org.quarkword.lib</groupId>
      <artifactId>quarkword-lib-wp-password</artifactId>
    </dependency>

    <dependency>
      <groupId>org.quarkword.testing</groupId>
      <artifactId>quarkword-test-gen</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>shade</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <artifactSet>
                <includes>
                  <include>org.quarkword.lib:quarkword-lib-wp-password</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>org.quarkword.lib.wppassword</pattern>
                  <shadedPattern>org.quarkword.keycloak.wppassword.internal.lib</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <!-- the lib's manifest names its own module; this jar's manifest is the one kept -->
                <filter>
                  <artifact>org.quarkword.lib:quarkword-lib-wp-password</artifact>
                  <excludes>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <!-- drops any licence file of the included jars; the repository's LICENSE is added below -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/LICENSE</resource>
                  <file>${project.basedir}/../LICENSE</file>
                </transformer>
                <!-- merges the repository's NOTICE (added to META-INF by the resources below); the names make the
                     transformer's own attribution line true for this project -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                  <projectName>QuarkWord Keycloak providers</projectName>
                  <inceptionYear>2026</inceptionYear>
                  <organizationName>the QuarkWord contributors</organizationName>
                  <organizationURL>https://github.com/QuarkWord</organizationURL>
                  <preamble3 xml:space="preserve">This product includes software developed by </preamble3>
                  <encoding>UTF-8</encoding>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- A fixed file name for mounting into Keycloak's providers/ directory (the integration tests, and the
           QuarkWord monorepo's end-to-end test) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>provider-jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/quarkword-keycloak-wp-password.jar" overwrite="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- JBoss Logging writes to JUL in the unit tests, where the log capture runs -->
            <org.jboss.logging.provider>jdk</org.jboss.logging.provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- the NOTICE is merged into the jar's META-INF/NOTICE by the shade plugin -->
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes>
          <include>NOTICE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>
  </build>
</project>
